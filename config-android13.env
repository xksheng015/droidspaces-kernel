KERNEL_SOURCE=https://github.com/TwinbornPlate75/android_kernel_xiaomi_sm8150
KERNEL_SOURCE_BRANCH=android13
KERNEL_CONFIG=raphael_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb

KSU_VARIANT=none
ADD_OVERLAYFS_CONFIG=true
ENABLE_DROIDSPACES=true
ENABLE_STOCKCONFIG=false
DISABLE_LTO=true
DISABLE_CC_WERROR=true

CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
USE_LLVM=true
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true

EXTRA_CMDS=CLANG_TRIPLE=aarch64-linux-gnu-
EXTRA_DEFCONFIG=CONFIG_DEVTMPFS=y CONFIG_DEVTMPFS_MOUNT=y CONFIG_PID_NS=y CONFIG_IPC_NS=y CONFIG_USER_NS=y CONFIG_UTS_NS=y CONFIG_NET_NS=y CONFIG_SYSVIPC=y CONFIG_POSIX_MQUEUE=y CONFIG_NF_TABLES=y CONFIG_NF_TABLES_INET=y CONFIG_NF_TABLES_IPV4=y CONFIG_NF_TABLES_IPV6=y CONFIG_NF_CONNTRACK=y CONFIG_NETFILTER=y CONFIG_MACVLAN=y CONFIG_SECCOMP_FILTER=y CONFIG_CGROUP_PIDS=y CONFIG_CGROUP_DEVICE=y CONFIG_CGROUP_FREEZER=y CONFIG_CGROUP_SCHED=y CONFIG_CFS_BANDWIDTH=y CONFIG_MEMCG=y CONFIG_MEMCG_SWAP=y CONFIG_F2FS_FS_COMPRESSION=y CONFIG_TMPFS_XATTR=y CONFIG_TMPFS_POSIX_ACL=y CONFIG_OVERLAY_FS=y
