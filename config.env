KERNEL_SOURCE=https://github.com/onettboots/bool-x_xiaomi_raphael
KERNEL_SOURCE_BRANCH=14-Miui
KERNEL_CONFIG=raphael_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb

KSU_VARIANT=none
ADD_OVERLAYFS_CONFIG=true
ENABLE_DROIDSPACES=true
ENABLE_STOCKCONFIG=true
DISABLE_LTO=true
DISABLE_CC_WERROR=true

CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
USE_LLVM=false
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true

EXTRA_CMDS=OBJCOPY=llvm-objcopy NM=llvm-nm
EXTRA_DEFCONFIG=CONFIG_KSU=y CONFIG_DEVTMPFS=y CONFIG_DEVTMPFS_MOUNT=y CONFIG_PID_NS=y CONFIG_IPC_NS=y CONFIG_USER_NS=y CONFIG_NF_TABLES=y CONFIG_F2FS_FS_COMPRESSION=y CONFIG_SYSVIPC=y CONFIG_TMPFS_XATTR=y CONFIG_OVERLAY_FS=y CONFIG_COMPAT=n